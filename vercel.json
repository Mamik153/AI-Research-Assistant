{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://ai-research-assistant-backend-production-7c89.up.railway.app/api/:path*"
    },
    {
      "source": "/static/:path*",
      "destination": "https://ai-research-assistant-backend-production-7c89.up.railway.app/static/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
