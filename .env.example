# UI Configuration
VITE_USE_DYNAMIC_UI=true

# Public site URL for SEO (canonical, OG, sitemap). Set in production to e.g. https://slickresearch.example.com
# VITE_APP_URL=https://your-domain.com

# Backend API Key (server-side only, never exposed to browser)
# API_KEY=your_backend_api_key_here

# Backend API URL (used by BFF proxy)
# API_BASE_URL=http://localhost:8000
